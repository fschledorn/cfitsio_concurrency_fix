# ThreadSanitizer suppressions for cfitsio concurrency tests

# Suppress benign races in std::cout from test program
# Multiple threads printing to stdout is safe (just interleaved output)
race:std::basic_ostream
race:std::ostreambuf_iterator
race:std::__1::basic_ostream
race:std::__1::ostreambuf_iterator

# Suppress benign races on Fitsio_Pthread_Status
# This global is written by FFLOCK/FFUNLOCK macros to store pthread return values
# The writes are atomic and the value is not used for synchronization
race:Fitsio_Pthread_Status
